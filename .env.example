# Режим работы приложения: development, testing или production.
SUPPORT_ENVIRONMENT=development

# Включает подробный режим отладки Flask. В production должен быть false.
SUPPORT_DEBUG=false

# Секрет Flask для подписи сессий и токенов. Замените на длинную случайную строку;
# в production обязательно задайте уникальное значение.
SUPPORT_SECRET_KEY=replace-with-a-long-random-secret

# Строка подключения к PostgreSQL в формате SQLAlchemy.
# Для Docker Compose имя хоста БД — db; при локальном запуске вне Docker используйте localhost.
SUPPORT_DATABASE_URL=postgresql+psycopg://support:support@db:5432/support

# Вывод SQL-запросов SQLAlchemy в журнал (true/false). Обычно оставляют false.
SUPPORT_DATABASE_ECHO=false

# Email администратора, используемый как значение по умолчанию при bootstrap.
SUPPORT_ADMIN_EMAIL=admin@example.com

# Хранилище ограничений частоты запросов: memory:// для одного процесса,
# redis:// или rediss:// для общего хранилища между несколькими worker-процессами.
# В production требуется Redis.
SUPPORT_RATE_LIMIT_STORAGE_URI=memory://

# Внешний базовый URL приложения. Используется, в частности, для ссылок восстановления пароля.
# В production укажите публичный HTTPS-адрес.
SUPPORT_PUBLIC_BASE_URL=http://localhost:5000

# Срок действия ссылки восстановления пароля в секундах (по умолчанию 1800 = 30 минут).
SUPPORT_PASSWORD_RESET_TOKEN_MAX_AGE_SECONDS=1800

# SMTP-сервер для отправки писем восстановления пароля и приглашений сотрудников.
# Для production обязательны SMTP_HOST и SMTP_SENDER; логин и пароль задаются парой.
SUPPORT_SMTP_HOST=
SUPPORT_SMTP_PORT=587
SUPPORT_SMTP_USERNAME=
SUPPORT_SMTP_PASSWORD=
SUPPORT_SMTP_SENDER=
# Использовать TLS при подключении к SMTP (true/false). В production должно быть true.
SUPPORT_SMTP_USE_TLS=true

# Таймаут SMTP-подключения в секундах.
SUPPORT_SMTP_TIMEOUT_SECONDS=10

# Адрес Ollama API. В Docker Compose приложение обращается к сервису ollama.
SUPPORT_OLLAMA_BASE_URL=http://localhost:11434

# Имя локальной модели Ollama. Docker Compose использует эту переменную
# также для загрузки модели сервисом ollama-model.
SUPPORT_OLLAMA_MODEL=qwen2.5:3b

# Источник данных для интеграции регистрации с основной системой:
# mock — локальная заглушка для разработки; http — реальный API (обязателен в production).
SUPPORT_REGISTRATION_PROVIDER=mock

# HTTPS-базовый URL API основной системы (обязателен при SUPPORT_REGISTRATION_PROVIDER=http).
SUPPORT_REGISTRATION_API_BASE_URL=

# Путь GET-метода получения профиля для предварительного заполнения регистрации.
SUPPORT_REGISTRATION_PROFILE_PATH=/api/v1/support/registration-profile

# Путь POST-метода обмена одноразового регистрационного токена.
SUPPORT_REGISTRATION_REDEEM_PATH=/api/v1/support/registration-token/redeem

# Секретный токен сервисного доступа к API основной системы.
# Не публикуйте его и не добавляйте реальные значения в Git.
SUPPORT_REGISTRATION_SERVICE_TOKEN=

# Таймаут запросов к API основной системы в секундах.
SUPPORT_REGISTRATION_TIMEOUT_SECONDS=5
